{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "bare-kylling",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/toppliste.js": {
      "includeFiles": "bare-kylling/js/spill/bane.mjs"
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/index",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/faq.html",
      "destination": "/faq",
      "statusCode": 301
    },
    {
      "source": "/hvorfor.html",
      "destination": "/hvorfor",
      "statusCode": 301
    },
    {
      "source": "/om-oss.html",
      "destination": "/om-oss",
      "statusCode": 301
    },
    {
      "source": "/smakene.html",
      "destination": "/smakene",
      "statusCode": 301
    },
    {
      "source": "/spill.html",
      "destination": "/spill",
      "statusCode": 301
    },
    {
      "source": "/venteliste.html",
      "destination": "/venteliste",
      "statusCode": 301
    }
  ]
}
